# Auth
AUTH_SECRET=generate-a-random-secret-here
AUTH_USERNAME=jorge
AUTH_PASSWORD=your-password-here

# OpenAI
OPENAI_API_KEY=sk-...
ALEX_MODEL=gpt-5.6-luna
ALEX_COMPLEX_MODEL=gpt-5.6-terra
ENGLISH_MODEL=gpt-5.6-luna
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# User context
USER_TIMEZONE=Europe/Madrid

# Gmail accounts (JSON array)
GMAIL_ACCOUNTS=[{"name":"Personal","email":"you@gmail.com","password":"app-password-16-chars"}]

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Supabase / NewsFlow (optional)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# English Coach Supabase (server-side only; never expose service key to browser)
ENGLISH_SUPABASE_URL=
ENGLISH_SUPABASE_SERVICE_KEY=
ENGLISH_SUPABASE_USER_ID=

# Notion (internal connection token; server-side only)
NOTION_API_KEY=
# English Coach — Biblioteca data source in Notion
NOTION_ENGLISH_DATA_SOURCE_ID=
# Central Actions data source in Notion
NOTION_ACTIONS_DATA_SOURCE_ID=
# Optional: stable page ID of “Technical Area — Bogor Hornbills”. If omitted,
# OpenClaw safely finds the shared hub by name before reading or writing.
NOTION_HORNBILLS_HUB_PAGE_ID=

# Debug
DEBUG=false
