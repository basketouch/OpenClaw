# === OpenClaw — Configuración ===
# Copia este archivo a .env y completa los valores

# Credenciales de acceso a la interfaz web
AUTH_USERNAME=jorge
AUTH_PASSWORD=cambia-esta-clave
# Secreto interno de sesión (genera con: openssl rand -hex 32)
AUTH_SECRET=cambia-este-valor-ahora

# === Anthropic (Claude) ===
ANTHROPIC_API_KEY=sk-ant-...
# Modelos disponibles: claude-opus-4-7 | claude-sonnet-4-6 | claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-sonnet-4-6

# === Debug ===
DEBUG=false

# === Gmail (App Passwords) ===
# Activa IMAP en Gmail: Ajustes → Ver todos → Reenvío e IMAP → Habilitar IMAP
# Crea App Password: Google Account → Seguridad → Verificación en 2 pasos → Contraseñas de aplicación
# Formato JSON — añade tantas cuentas como quieras
GMAIL_ACCOUNTS=[{"name":"Personal","email":"tu@gmail.com","password":"xxxx xxxx xxxx xxxx"}]
# Ejemplo con dos cuentas:
# GMAIL_ACCOUNTS=[{"name":"Personal","email":"jorge@gmail.com","password":"xxxx xxxx xxxx xxxx"},{"name":"Trabajo","email":"jorge@basketouch.com","password":"xxxx xxxx xxxx xxxx"}]
