# Auth
AUTH_SECRET=generate-a-random-secret-here
AUTH_USERNAME=jorge
AUTH_PASSWORD=your-password-here

# Anthropic
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Proveedor de modelo: "anthropic" | "glm" | "groq"
MODEL_PROVIDER=anthropic

# GLM (Z.ai) - opcional, requiere plan de pago
GLM_API_KEY=
GLM_MODEL=glm-5.2

# Groq - opcional
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gmail accounts (JSON array)
GMAIL_ACCOUNTS=[{"name":"Personal","email":"you@gmail.com","password":"app-password-16-chars"}]

# WhatsApp (WAHA)
WAHA_URL=http://waha:3000
WAHA_SESSION=default
TTS_VOICE=es-ES-AlvaroNeural

# WhatsApp contacts (JSON array, optional)
